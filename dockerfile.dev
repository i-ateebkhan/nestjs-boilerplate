FROM node:22-alpine

WORKDIR /app

# Skip husky git hooks during container install
ENV HUSKY=0

RUN corepack enable

# Prisma schema + config must be present before install,
# since `postinstall` runs `prisma generate`.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts ./
COPY ./prisma ./prisma

# Install dependencies (also generates the Prisma client via postinstall)
RUN pnpm install

# Copy source files
COPY ./src ./src
COPY tsconfig.json nest-cli.json ./

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodeuser -u 1001 -G nodejs

# Change ownership of app directory
RUN chown -R nodeuser:nodejs /app

# Switch to non-root user
USER nodeuser

# Expose port
EXPOSE 5000

# Set development environment
ENV NODE_ENV=development

# Start development server with hot reload
CMD ["pnpm", "dev"]
