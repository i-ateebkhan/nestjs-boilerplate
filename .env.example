PG_URL=postgresql://postgres:1234@localhost:5432/local_db
# generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-chars
# seconds: 15 minutes / 7 days
JWT_ACCESS_EXP=900
JWT_REFRESH_EXP=604800
